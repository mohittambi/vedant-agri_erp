# ============================================================================
# AGRI INPUT ERP — Environment Variables
# Copy this file to `.env.local` and fill in real values from your Supabase
# project dashboard (Project Settings → API and Project Settings → Database).
# NEVER commit `.env.local`.
# ============================================================================

# --- Supabase API ------------------------------------------------------------
# Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
# Project Settings → API → Project API keys → anon / public
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
# Project Settings → API → Project API keys → service_role (SERVER ONLY — keep secret)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# --- Database (Prisma) -------------------------------------------------------
# Project Settings → Database → Connection string.
# DATABASE_URL uses the pooled (pgBouncer, port 6543) connection for runtime.
# DIRECT_URL uses the direct (port 5432) connection for migrations.
DATABASE_URL="postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# --- App ---------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Agri Input ERP"

# --- WhatsApp Cloud API (Meta) ----------------------------------------------
# https://developers.facebook.com/docs/whatsapp/cloud-api
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_API_VERSION="v21.0"
